generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Client {
  id                  String              @id @default(cuid())
  nom                 String
  prenom              String
  statutJuridique     String
  siret               String?             @unique
  codeApe             String
  adresse             String?
  codePostal          String?
  ville               String?
  email               String
  telephone           String?
  dateCreation        DateTime            @default(now())
  dateMAJ             DateTime            @updatedAt
  activitePrincipale  String?
  ancienneteDirection String?
  civilite            String?
  dateNaissance       DateTime?
  niveauDiplome       String?
  nomCommercial       String?
  nomNaissance        String?
  numeroSS            String?
  conversations       ConversationEmail[]
  dossiers            Dossier[]
  notes               NoteClient[]
  lead                Lead?

  @@map("clients")
}

model ConversationEmail {
  id        String         @id @default(cuid())
  clientId  String
  sujet     String
  statut    String         @default("ouvert")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages  MessageEmail[]

  @@map("conversations_email")
}

model MessageEmail {
  id             String            @id @default(cuid())
  conversationId String
  direction      String
  expediteur     String
  destinataire   String
  sujet          String?
  contenu        String
  brouillon      Boolean           @default(false)
  envoye         Boolean           @default(false)
  dateEnvoi      DateTime?
  lu             Boolean           @default(false)
  createdAt      DateTime          @default(now())
  attachments    AttachmentEmail[]
  conversation   ConversationEmail @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages_email")
}

model AttachmentEmail {
  id        String       @id @default(cuid())
  messageId String
  nom       String
  type      String
  taille    Int
  chemin    String
  createdAt DateTime     @default(now())
  message   MessageEmail @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("attachments_email")
}

model NoteClient {
  id        String   @id @default(cuid())
  clientId  String
  contenu   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("notes_client")
}

model Formation {
  id                    String    @id @default(cuid())
  reference             String    @unique
  intitule              String
  programme             String
  objectifs             String?
  publicCible           String?
  prerequis             String?
  thematique            String?
  moduleType            String?
  typeQualification     String?
  nomFormateur          String?
  dureeHeures           Float
  dureePresIndividuel   Float?
  dureePresCollectif    Float?
  dureeDistSynchrone    Float?
  dureeDistAsynchrone   Float?
  tarifInterHT          Float
  tarifIntraHT          Float
  plafondAGEFICE        Float?
  modalite              String    @default("presentiel")
  formationEnEntreprise Boolean   @default(false)
  certifiant            Boolean   @default(false)
  eligibleCPF           Boolean   @default(false)
  referenceRS           String?
  actif                 Boolean   @default(true)
  dateCreation          DateTime  @default(now())
  dateMAJ               DateTime  @updatedAt
  dossiers              Dossier[]

  @@map("formations")
}

model Dossier {
  id                          String        @id @default(cuid())
  numero                      String        @unique
  clientId                    String
  formationId                 String
  dateDebut                   DateTime
  dateFin                     DateTime
  dateLimiteDepot             DateTime
  dateLimiteRemboursement     DateTime
  montantHT                   Float
  tauxTVA                     Float         @default(0)
  montantTTC                  Float
  typeAction                  String        @default("formation")
  formationObligatoire        Boolean       @default(false)
  reconversion                Boolean       @default(false)
  formationEnEntreprise       Boolean       @default(false)
  modalite                    String
  lieuFormationAdresse        String?
  lieuFormationCodePostal     String?
  lieuFormationVille          String?
  nomFormateur                String?
  nombreParticipants          Int           @default(1)
  dureePresIndividuel         Float?
  dureePresCollectif          Float?
  dureeDistSynchrone          Float?
  dureeDistAsynchrone         Float?
  dureePresIndividuelRealisee Float?
  dureePresCollectifRealisee  Float?
  dureeDistSynchroneRealisee  Float?
  dureeDistAsynchroneRealisee Float?
  modalitesDeroulement        String?
  modalitesEvaluation         String?
  typeCertification           String?
  modeReglement               String?
  dateReglement               DateTime?
  statut                      String        @default("en_preparation")
  notes                       String?
  dateCreation                DateTime      @default(now())
  dateMAJ                     DateTime      @updatedAt
  montantPriseEnCharge        Float?
  nomFinanceur                String?
  remiseMontant               Float?
  remisePourcent              Float?
  typeFinancement             String?
  evaluationNotes             String?
  joursSession                String?
  notationGlobale             String?
  alertes                     Alerte[]
  documents                   Document[]
  formation                   Formation     @relation(fields: [formationId], references: [id])
  client                      Client        @relation(fields: [clientId], references: [id])
  pieces                      PieceClient[]

  @@map("dossiers")
}

model Document {
  id             String   @id @default(cuid())
  dossierId      String
  type           String
  nomFichier     String?
  urlStockage    String?
  dateGeneration DateTime @default(now())
  signe          Boolean  @default(false)
  valide         Boolean  @default(false)
  contenu        String?
  signatureEleve String?
  signatureOF    String?
  tokenEleve     String?  @unique
  tokenOF        String?  @unique
  dossier        Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model PieceClient {
  id          String    @id @default(cuid())
  dossierId   String
  typePiece   String
  statut      String    @default("manquante")
  url         String?
  dateDepot   DateTime?
  commentaire String?
  dossier     Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("pieces_client")
}

model Alerte {
  id           String    @id @default(cuid())
  dossierId    String
  type         String
  dateEcheance DateTime
  envoyee      Boolean   @default(false)
  dateEnvoi    DateTime?
  canal        String    @default("email")
  dossier      Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("alertes")
}

model SessionFormation {
  id        String   @id @default(cuid())
  leadId    String
  titre     String
  dateDebut DateTime
  dateFin   DateTime
  lieu      String?
  notes     String?
  statut    String   @default("planifie")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("sessions_formation")
}

model Parametre {
  id          String  @id @default(cuid())
  cle         String  @unique
  valeur      String
  description String?
  categorie   String  @default("general")

  @@map("parametres")
}

model Lead {
  id                String    @id @default(cuid())
  nomEntreprise     String
  siret             String?
  siren             String?
  codeApe           String?
  secteurActivite   String?
  chiffreAffaires   Float?
  effectif          Int?
  adresse           String?
  codePostal        String?
  ville             String?
  nomDirigeant      String
  prenomDirigeant   String?
  telephone         String?
  email             String?
  descriptionEnjeux String?
  messagePrepare    String?
  statut            String    @default("nouveau")
  canalContact      String?
  dateContact       DateTime?
  scoreLead         Int?
  feedbackHumain    String?
  sourceDonnee      String?   @default("pappers")
  dateDecouverte    DateTime  @default(now())
  dateMAJ           DateTime  @updatedAt
  siteWeb           String?
  emailStatus       String?
  linkedinUrl       String?
  titrePoste        String?
  clientId          String?   @unique
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  dateQualification DateTime?
  dateInscription   DateTime?
  sessions          SessionFormation[]

  @@map("leads")
}

model PostBlog {
  id           String   @id @default(cuid())
  titre        String
  accroche     String?
  introduction String?
  sections     String?
  conclusion   String?
  motsCles     String?
  hashtags     String?
  photoUrl     String?
  photoCaption String?
  sujet        String?
  ton          String?
  publicCible  String?
  statut       String   @default("brouillon")
  dateCreation DateTime @default(now())
  dateMAJ      DateTime @updatedAt

  @@map("posts_blog")
}

model LandingPage {
  id           String          @id @default(cuid())
  nom          String
  sujet        String
  publicCible  String?
  offre        String?
  template     String
  statut       String          @default("brouillon")
  dateCreation DateTime        @default(now())
  dateMAJ      DateTime        @updatedAt
  variants     LandingVariant[]

  @@map("landing_pages")
}

model LandingVariant {
  id           String      @id @default(cuid())
  landingId    String
  nom          String
  angle        String?
  palette      String      @default("bleu")
  contenu      String
  actif        Boolean     @default(false)
  vues         Int         @default(0)
  conversions  Int         @default(0)
  dateCreation DateTime    @default(now())
  landing      LandingPage @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@map("landing_variants")
}
