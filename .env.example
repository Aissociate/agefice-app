# ============================================================
# AGEFICE App — variables d'environnement
# ============================================================

# Base de données SQLite via libSQL (compatible WebContainer/Bolt)
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------------------
# CORS — origines autorisées supplémentaires (séparées par virgule)
# ------------------------------------------------------------
CORS_ORIGIN=
# Origines autorisées pour les ressources dev Next.js
ALLOWED_DEV_ORIGINS=

# ------------------------------------------------------------
# Authentification (à changer en prod)
# ------------------------------------------------------------
APP_PASSWORD=MotDePasseSecurise123!
AUTH_SECRET=une_chaine_aleatoire_longue_et_secrete_a_changer

# ------------------------------------------------------------
# Intégrations API (toutes optionnelles, fonctionnent en WebContainer)
# ------------------------------------------------------------
# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Pappers — https://www.pappers.fr/api
PAPPERS_API_TOKEN=
# Google Places — https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=
# Google Sheets (lecture publique via clé API)
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=
# Apify — scraper leads
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
# Pexels — photos pour le générateur de blog
PEXELS_API_KEY=

# URL formulaire contact
CONTACT_FORM_URL=https://aissociate.re/formulaire

# ------------------------------------------------------------
# ⚠️  Non supporté sur Bolt.new / WebContainer
# ------------------------------------------------------------
# SMTP (nodemailer) et IMAP (imapflow) utilisent du TCP brut, non disponible
# en WebContainer. Les modules lib/mailer.ts et lib/imap.ts sont stubbés.
# Pour réactiver ces fonctionnalités, déployer sur Vercel/VPS Node et utiliser
# un service HTTP (Resend, Postmark, SendGrid…) à la place de nodemailer.
